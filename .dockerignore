# Version control
.git
.gitignore

# Python caches
__pycache__
*.pyc
*.pyo
*.pyd
.pytest_cache

# Virtual environments
.venv
env
venv

# Node (frontend sources stay in context — Dockerfile.admin/.customer build
# them from the repo root; node_modules are never needed in any image)
**/node_modules

# Test suite (not needed at runtime)
tests

# Raw data files (mounted or provided at runtime; not baked into image)
data

# Local logs and scratch dirs
logs
app

# OS / editor noise
.DS_Store
Thumbs.db
*.swp

# Conda environment spec (not needed in Docker)
environment_ai_close.yml
