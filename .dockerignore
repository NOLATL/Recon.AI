# Version control
.git
.gitignore

# Python caches
__pycache__
*.pyc
*.pyo
*.pyd
.pytest_cache

# Virtual environments
.venv
env
venv

# Node / frontend (separate container or build step)
node_modules
frontend

# Test suite (not needed at runtime)
tests

