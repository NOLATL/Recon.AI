# Customer UI — built from repo root as context (Railway CLI uploads the repo
# root; RAILWAY_DOCKERFILE_PATH on the customer-ui service points here).
FROM node:20-alpine AS build

WORKDIR /app

COPY frontend-customer/package.json frontend-customer/package-lock.json ./
RUN npm ci

COPY frontend-customer/ .

ARG VITE_API_BASE_URL
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL

RUN npm run build

FROM caddy:2-alpine

COPY frontend-customer/Caddyfile /etc/caddy/Caddyfile
COPY --from=build /app/dist /srv
